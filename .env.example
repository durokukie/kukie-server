JWT_SECRET=         # Must be at least 32 bytes

# AWS credentials
# - Local: keep commented out to use the ~/.aws default profile
# - Deploy: uncomment and set the IAM user's access key
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# OAuth callback URL: <origin>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must be an OAuth client registered as the "Web application" type
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the agent's value
KUKIE_INTERNAL_TOKEN=

# GitHub App kukie-gitops (App ID 5531779). Private key PEM; literal \n line breaks are accepted
GITHUB_APP_ID=5531779
GITHUB_APP_PRIVATE_KEY=
# Optional: the App's OAuth client (enable "Request user authorization (OAuth) during installation")
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# base64 of exactly 32 bytes (openssl rand -base64 32)
KUKIE_CREDENTIAL_KEY=

# Optional: Hugging Face read token for the GPU model candidates (anonymous works, with a lower rate limit)
HF_TOKEN=

# Optional: hosting is on only when both the bucket and the queue are set
HOSTING_STATE_BUCKET=
HOSTING_COMMANDS_QUEUE_URL=

# Optional: OpenAI API key for the AI cause analysis of failed hosting deploys and the AI outline of reports
# (when empty, the analysis is off and reports are built without the outline)
OPENAI_API_KEY=

# Optional: Claude API key. When set, reports are outlined by Claude (claude-sonnet-5-5) instead of OpenAI
ANTHROPIC_API_KEY=
