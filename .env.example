JWT_SECRET=         # Must be at least 32 bytes

# AWS credentials
# - Local: keep commented out to use the ~/.aws default profile
# - Deploy: uncomment and set the IAM user's access key
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

WEB_APP_URL=http://localhost:5173

# OAuth callback URL: <origin>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must be an OAuth client registered as the "Web application" type
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cookie Secure flag: false only for local http
AUTH_COOKIE_SECURE=false
