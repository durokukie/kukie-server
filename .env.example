JWT_SECRET=         # Must be at least 32 bytes

MAIL_USERNAME=
MAIL_PASSWORD=      # Don't include space

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must be an OAuth client registered as the "Desktop app" type
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ▼ 웹용 (선택). 없으면 웹 로그인(redirectUri 가 127.0.0.1 루프백이 아닌 요청)만 503 이고 앱 로그인은 그대로 된다.
#   구글은 "Web application" 타입으로 새로 발급, 깃허브는 OAuth App 을 하나 더 (콜백 주소가 앱당 하나라서).
GITHUB_WEB_CLIENT_ID=
GITHUB_WEB_CLIENT_SECRET=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=

# 토큰 쿠키의 Secure 속성. 로컬 http 개발에서만 false — 배포(https)에서는 지우거나 true
AUTH_COOKIE_SECURE=false
