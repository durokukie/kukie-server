JWT_SECRET=         # Must be at least 32 bytes

MAIL_USERNAME=
MAIL_PASSWORD=      # Don't include space

# 콜백 주소는 둘 다 <origin>/auth/callback (로컬: http://localhost:5173/auth/callback). 화면의 VITE_*_WEB_CLIENT_ID 와 같은 클라이언트여야 한다
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Must be an OAuth client registered as the "Web application" type
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 토큰 쿠키의 Secure 속성. 로컬 http 개발에서만 false — 배포(https)에서는 지우거나 true
AUTH_COOKIE_SECURE=false
